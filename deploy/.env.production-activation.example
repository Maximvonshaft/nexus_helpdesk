# Production activation overlay.
# Start from a fully accepted and already-running controlled deployment. Copy the
# reviewed values below into the controlled host environment only after the real
# end-to-end evidence bundle exists. Never use placeholders and never commit secrets.
#
# Use with:
#   docker compose \
#     --env-file deploy/.env.controlled \
#     --env-file deploy/.env.production-activation \
#     -f deploy/docker-compose.controlled.yml \
#     -f deploy/docker-compose.production-activation.yml \
#     up -d

PRODUCTION_PROFILE=full

# Bind the signed evidence bundle to one exact candidate, configuration and target
# environment. First finish every non-secret runtime value below, then generate the
# only accepted digest with:
#   python scripts/deploy/render_activation_configuration.py \
#     --env-file deploy/.env.controlled \
#     --env-file deploy/.env.production-activation \
#     --output /tmp/nexus-activation-configuration.json
# Copy configuration_digest from that receipt into the value below and into the
# unsigned Manifest before signing. Runtime preflight recomputes the digest and
# rejects any later configuration drift. The environment ID is a stable deployment
# identity; it is not a hostname guessed by the script.
ACTIVATION_EVIDENCE_SOURCE_SHA=<same-40-hex-value-as-GIT_SHA>
ACTIVATION_EVIDENCE_IMAGE_DIGEST=sha256:<same-64-hex-digest-as-CONTROLLED_IMAGE>
ACTIVATION_EVIDENCE_CONFIGURATION_DIGEST=sha256:<generated-runtime-configuration-digest>
ACTIVATION_EVIDENCE_ENVIRONMENT_ID=production-eu-1

# The manifest must use schema nexus.activation-evidence.v3 and be signed by the
# offline Ed25519 private key. The application and preflight receive only the
# signed Manifest and public verification key; private/signing key material is
# forbidden in runtime environment variables and mounts.
#
# Offline signing example:
#   python scripts/deploy/sign_activation_evidence.py \
#     --input /secure/reviewed-activation-manifest.json \
#     --private-key-file /offline/nexus-activation-ed25519-private.pem \
#     --key-id activation-key-2026-07 \
#     --output /opt/nexus_helpdesk/activation/manifest.json
#
# Each evidence entry must contain a passing result, artifact SHA-256, generated_at
# timestamp and the same candidate/config/environment binding. The URL is only a
# locator; it cannot authorize production without the verified signed entry.
NEXUS_ACTIVATION_EVIDENCE_MANIFEST_HOST_PATH=/opt/nexus_helpdesk/activation/manifest.json
NEXUS_ACTIVATION_EVIDENCE_PUBLIC_KEY_HOST_PATH=/opt/nexus_helpdesk/activation/public_key.pem
ACTIVATION_EVIDENCE_KEY_ID=activation-key-2026-07

# Immutable HTTPS evidence references. Values must exactly match the corresponding
# signed Manifest entries.
PRODUCTION_E2E_EVIDENCE_URL=https://github.com/Maximvonshaft/nexus_helpdesk/actions/runs/<full-production-e2e-run-id>
PROVIDER_CANARY_E2E_EVIDENCE_URL=https://github.com/Maximvonshaft/nexus_helpdesk/actions/runs/<provider-canary-e2e-run-id>
WEBCHAT_AI_PRODUCTION_E2E_EVIDENCE_URL=https://github.com/Maximvonshaft/nexus_helpdesk/actions/runs/<webchat-ai-e2e-run-id>
TELEPHONY_PRODUCTION_E2E_EVIDENCE_URL=
OUTBOUND_PRODUCTION_E2E_EVIDENCE_URL=
WHATSAPP_PRODUCTION_E2E_EVIDENCE_URL=

# Canonical Agent Runtime production activation.
PROVIDER_RUNTIME_ENABLED=true
PROVIDER_RUNTIME_TRAFFIC_MODE=full
PROVIDER_RUNTIME_KILL_SWITCH=false
PROVIDER_RUNTIME_CANARY_PERCENT=100
PRIVATE_AI_RUNTIME_ENABLED=true
WEBCHAT_AI_ENABLED=true
WEBCHAT_AI_AUTO_REPLY_MODE=runtime
WEBCHAT_AI_RECONCILER_ENABLED=true

# External customer delivery remains one master kill-switch plus per-capability
# evidence. Set these only when the exact candidate has passed Provider tests.
ENABLE_OUTBOUND_DISPATCH=false
OUTBOUND_PROVIDER=disabled

# The bounded SMTP pilot is the only Email activation currently authorized by this
# overlay. It additionally requires outbound dispatch, provider email/smtp and
# OUTBOUND_PRODUCTION_E2E_EVIDENCE_URL bound to the same signed Manifest.
OUTBOUND_EMAIL_PRODUCTION_PILOT_ENABLED=false

# WhatsApp is one canonical channel with independently deployable transports.
# Meta-only: set a real HTTPS webhook URL and leave whatsapp-baileys absent.
# Baileys-only: leave the Meta webhook empty, add whatsapp-baileys and provide the
# exact Sidecar image digest. Dual transport satisfies both sets of requirements.
WHATSAPP_ENABLED=false
WHATSAPP_META_WEBHOOK_PUBLIC_URL=
WHATSAPP_SIDECAR_IMAGE=ghcr.io/maximvonshaft/nexus_helpdesk-whatsapp-sidecar@sha256:<64-hex-digest>

# Meta Embedded Signup is optional and does not affect Baileys. When enabled it
# requires a configured Meta transport and the exact approved Meta App assets.
# The App Secret itself belongs in /run/nexus/whatsapp_meta_app_secret.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET_FILE=/run/nexus/whatsapp_meta_app_secret
WHATSAPP_META_CONFIGURATION_ID=
WHATSAPP_META_GRAPH_API_VERSION=
WHATSAPP_EMBEDDED_SIGNUP_ALLOWED_ORIGIN=

# Docker Compose uses COMPOSE_PROFILES (plural). Add whatsapp-baileys for Baileys
# and whatsapp-media whenever media receive/send is enabled. Profiles are comma-
# separated, for example: whatsapp-baileys,whatsapp-media.
COMPOSE_PROFILES=

# Media is fail-closed in production. Enabling it requires the whatsapp-media
# profile, a digest-pinned ClamAV image and the real ClamAV scanner contract.
WHATSAPP_MEDIA_ENABLED=false
WHATSAPP_MEDIA_SCANNER=disabled
WHATSAPP_CLAMAV_IMAGE=docker.io/clamav/clamav@sha256:<64-hex-digest>
WHATSAPP_CLAMAV_HOST=clamav-controlled
WHATSAPP_CLAMAV_PORT=3310
WHATSAPP_CLAMAV_TIMEOUT_SECONDS=20
WHATSAPP_MEDIA_MAX_TOTAL_BYTES=104857600

# Voice remains disabled until the real LiveKit/SIP/STT/TTS environment and signed
# telephony evidence are present.
WEBCHAT_HUMAN_CALL_ENABLED=false
WEBCHAT_LIVE_AI_VOICE_ENABLED=false
WEBCHAT_VOICE_PROVIDER=mock
LIVEKIT_URL=
LIVEKIT_WEBHOOK_ENABLED=false
LIVEKIT_AGENT_NAME=
NEXUS_VOICE_STT_MODEL=
NEXUS_VOICE_TTS_MODEL=

# These capabilities have source implementations or historical configuration
# surfaces but do not yet have an admitted production runtime/evidence authority.
# The activation preflight rejects any attempt to enable them.
EMAIL_MAILBOX_SYNC_ENABLED=false
OPERATIONS_DISPATCH_MODE=disabled
OPERATIONS_DISPATCH_ADAPTER=disabled
