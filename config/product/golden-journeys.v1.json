      "primary_metrics": ["safe_effective_closure_rate", "average_human_touches", "reopen_72h_rate", "provider_failure_rate"],
      "failure_injections": ["attempt_evidence_conflict", "no_available_owner", "provider_receipt_missing", "customer_disputes_closure"]
    }
  ]
